{
  "name": "@rovo/config",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared tsconfig bases, ESLint flat config, Vite app config, Tailwind v4 theme and design tokens",
  "exports": {
    "./tsconfig/base.json": "./tsconfig/base.json",
    "./tsconfig/react.json": "./tsconfig/react.json",
    "./tsconfig/node.json": "./tsconfig/node.json",
    "./eslint": "./eslint.js",
    "./vite": "./src/vite.ts",
    "./tokens": "./src/tokens.ts",
    "./theme.css": "./theme.css",
    "./fonts.css": "./fonts.css"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@eslint/js": "catalog:",
    "@fontsource/noto-sans-telugu": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "eslint-plugin-jsx-a11y": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "eslint-plugin-react-refresh": "catalog:",
    "globals": "catalog:",
    "tailwindcss": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:",
    "vite-plugin-pwa": "catalog:",
    "workbox-build": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
