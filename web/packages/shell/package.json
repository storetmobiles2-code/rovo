{
  "name": "@rovo/shell",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared app shell for rovo frontends: providers, layout, error boundary, 404, login screens",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./runtime-config": "./src/runtime-config.ts"
  },
