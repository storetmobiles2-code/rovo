    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@rovo/api-client": "workspace:*",
    "@rovo/auth": "workspace:*",
    "@rovo/i18n": "workspace:*",
    "@rovo/ui": "workspace:*",
    "@rovo/utils": "workspace:*",
    "@tanstack/react-query": "catalog:",
    "lucide-react": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@rovo/config": "workspace:*",
    "@rovo/testing": "workspace:*",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
