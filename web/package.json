{
  "name": "rovo-web",
  "private": true,
  "version": "0.1.0",
  "description": "rovo web frontends: customer, restaurant, rider and admin apps plus shared packages",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./apps/*\" build && pnpm size",
    "dev": "pnpm -r --parallel --filter \"./apps/*\" dev",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gen:api": "pnpm --filter @rovo/api-client gen:api",
    "i18n:check": "node packages/i18n/scripts/check-i18n.mjs",
    "size": "node scripts/check-bundle-size.mjs",
    "brand:assets": "python3 scripts/gen-brand-assets.py",
    "check": "pnpm typecheck && pnpm lint && pnpm i18n:check && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@rovo/config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:"
  }
}
