# Copy to .env (the installer does this for you) and fill in the blanks.

# --- Required -------------------------------------------------------------
# Claude API key from https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
# Random secrets; the installer generates them. Keep N8N_ENCRYPTION_KEY stable:
# changing it makes n8n unable to read the Google credentials you saved.
N8N_ENCRYPTION_KEY=
BRIDGE_TOKEN=

# Folder holding your NotebookLM login (storage_state.json) on this computer.
# macOS/Linux: /Users/you/.notebooklm   Windows: C:/Users/you/.notebooklm
NOTEBOOKLM_HOME=

# --- YouTube upload -------------------------------------------------------
# private | unlisted | public. Start with private and review the first videos.
YOUTUBE_PRIVACY=private
YOUTUBE_REGION=US
YOUTUBE_NOTIFY_SUBSCRIBERS=false

# --- NotebookLM Video Overview --------------------------------------------
# explainer | brief | short (vertical) | cinematic (needs Google AI Ultra)
VIDEO_FORMAT=explainer
# auto | classic | whiteboard | kawaii | anime | watercolor | retro-print | heritage | paper-craft
VIDEO_STYLE=auto
VIDEO_LANGUAGE=en
# Optional steering for every video, e.g. "Aimed at beginners, upbeat tone"
VIDEO_INSTRUCTIONS=
# true deletes each NotebookLM notebook after its video is downloaded
DELETE_NOTEBOOK_AFTER=false
JOB_TIMEOUT_MINUTES=60

# --- Claude ---------------------------------------------------------------
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
# default = retry a declined request on a fallback model; off = disable
CLAUDE_FALLBACKS=default

TIMEZONE=UTC
