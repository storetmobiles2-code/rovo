# rovo configuration — LOCAL DEVELOPMENT defaults (fakes on, nothing real).
#
#   cp .env.example .env && make dev-keys      # or just: make bootstrap
#
# `make dev-keys` fills the empty secret values below with fresh random dev-only
# keys in .env (git-ignored). Never commit .env. Cloud environments inject these
# from AWS Secrets Manager instead (doc 22 §7).
#
# Key formats: ROVO_JWT_SIGNING_KEY = base64 (std) of a 32-byte Ed25519 seed;
# ROVO_QUOTE_SIGNING_KEY / ROVO_FIELD_ENCRYPTION_KEY = base64 (std) of 32 random
# bytes; VAPID keys = base64url (P-256 public 65 bytes / private 32 bytes).

# --- runtime ----------------------------------------------------------------
ROVO_ENV=local
ROVO_HTTP_ADDR=:8080
ROVO_INTERNAL_ADDR=:9090
ROVO_LOG_LEVEL=debug

# --- database (deploy/compose/compose.yaml) ---------------------------------
ROVO_DATABASE_URL=postgres://rovo:rovo@localhost:5432/rovo?sslmode=disable

# --- hosts / audiences --------------------------------------------------------
# Vite dev servers (make dev). The production-like stack (make prod-up) derives
# its own value from ROVO_DOMAIN:
#   app.rovo.localhost=customer,restaurant.rovo.localhost=restaurant,rider.rovo.localhost=rider,admin.rovo.localhost=admin,api.rovo.localhost=webhook
ROVO_APP_HOSTS=localhost:5173=customer,localhost:5174=restaurant,localhost:5175=rider,localhost:5176=admin
ROVO_CUSTOMER_BASE_URL=http://localhost:5173
ROVO_DOMAIN=rovo.localhost
ROVO_COOKIE_SECURE=false

# --- secrets (generated by `make dev-keys`; dev-only) -------------------------
ROVO_JWT_SIGNING_KEY=
ROVO_QUOTE_SIGNING_KEY=
ROVO_FIELD_ENCRYPTION_KEY=
# Sent by the edge (Vite proxy / Caddy / CloudFront) as X-Rovo-Origin-Verify.
ROVO_TRUSTED_ORIGIN_SECRET=
ROVO_ADMIN_BOOTSTRAP_PASSWORD=

# --- providers (fakes; no network needed) -------------------------------------
ROVO_PAYMENT_PROVIDER=fake
ROVO_FAKEPA_WEBHOOK_SECRET=
ROVO_SMS_PROVIDER=fake
ROVO_PUSH_VAPID_PUBLIC_KEY=
ROVO_PUSH_VAPID_PRIVATE_KEY=

# --- object storage (MinIO in compose; AWS S3 in the cloud) ------------------
ROVO_S3_ENDPOINT=http://localhost:9000
ROVO_S3_REGION=ap-south-1
ROVO_S3_ACCESS_KEY=rovo-dev
ROVO_S3_SECRET_KEY=rovo-dev-secret
ROVO_S3_BUCKET_MEDIA=media
ROVO_S3_BUCKET_KYC=kyc
ROVO_S3_PUBLIC_MEDIA_BASE_URL=http://localhost:9000/media

# --- email (Mailpit: UI http://localhost:8025) --------------------------------
ROVO_SMTP_ADDR=localhost:1025

# --- telemetry (empty = OTLP export off) --------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- test hooks (only in binaries built with -tags testhooks; empty = off) ----
ROVO_TESTHOOKS_ADDR=
ROVO_TESTHOOKS_SECRET=
