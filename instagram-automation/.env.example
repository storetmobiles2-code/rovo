# Copy to .env (the installer does this for you) and fill in the blanks.

# --- Required -------------------------------------------------------------
# Claude API key from https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
# Instagram access token (see README "Instagram access token"). The bridge
# refreshes it automatically every 7 days so it does not expire.
INSTAGRAM_ACCESS_TOKEN=
# Random secrets; the installer generates them. Keep N8N_ENCRYPTION_KEY stable:
# changing it makes n8n unable to read the Google credentials you saved.
N8N_ENCRYPTION_KEY=
BRIDGE_TOKEN=

# Folder holding your NotebookLM login (storage_state.json) on this computer.
# macOS/Linux: /Users/you/.notebooklm   Windows: C:/Users/you/.notebooklm
NOTEBOOKLM_HOME=

# --- Instagram ------------------------------------------------------------
# instagram = Instagram API with Instagram Login (simplest; uses the free
#             Cloudflare tunnel so Instagram can fetch the video)
# facebook  = Instagram API with Facebook Login (direct upload, no tunnel;
#             needs a Page access token and INSTAGRAM_USER_ID)
INSTAGRAM_LOGIN=instagram
INSTAGRAM_USER_ID=
# true = every Reel waits for you at http://localhost:8766 before posting.
# Instagram has no private mode: once posted, a Reel is public.
INSTAGRAM_REQUIRE_APPROVAL=true
APPROVAL_TIMEOUT_HOURS=72
INSTAGRAM_SHARE_TO_FEED=true
# Cover frame, in milliseconds from the start (empty = first frame)
INSTAGRAM_THUMB_OFFSET_MS=
INSTAGRAM_MAX_HASHTAGS=5
CAPTION_FOOTER=🤖 Video made with AI (NotebookLM) from the source material.
GRAPH_API_VERSION=v25.0
# Set only if you host the bridge behind your own public https URL instead of the tunnel
PUBLIC_BASE_URL=

# --- NotebookLM video -----------------------------------------------------
# short = vertical (best for Reels) | explainer | brief | cinematic (needs Google AI Ultra)
VIDEO_FORMAT=short
# Only for explainer/brief: auto | classic | whiteboard | kawaii | anime | watercolor | retro-print | heritage | paper-craft
VIDEO_STYLE=auto
VIDEO_LANGUAGE=en
# Optional steering for every video, e.g. "Upbeat, for a general audience"
VIDEO_INSTRUCTIONS=
DELETE_NOTEBOOK_AFTER=false
JOB_TIMEOUT_MINUTES=60

# --- Claude ---------------------------------------------------------------
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
# default = retry a declined request on a fallback model; off = disable
CLAUDE_FALLBACKS=default

TIMEZONE=UTC
