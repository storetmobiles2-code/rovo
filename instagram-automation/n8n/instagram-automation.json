{
  "id": "igAutoDriveNlmClaude",
  "name": "Instagram automation: Drive -> NotebookLM -> Claude -> Instagram Reels",
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true
  },
  "nodes": [
    {
      "id": "5e2a7c41-8b3d-4f60-9a1e-3c7d2f8b0001",
      "name": "New file in Drive folder",
      "type": "n8n-nodes-base.googleDriveTrigger",
      "typeVersion": 1,
      "position": [
        0,
        300
      ],
      "parameters": {
        "authentication": "oAuth2",
        "pollTimes": {
          "item": [
            {
              "mode": "everyX",
              "value": 5,
              "unit": "minutes"
            }
          ]
        },
        "triggerOn": "specificFolder",
        "folderToWatch": {
          "__rl": true,
          "value": "",
          "mode": "list"
        },
        "event": "fileCreated",
        "options": {}
      }
    },
    {
      "id": "5e2a7c41-8b3d-4f60-9a1e-3c7d2f8b0002",
      "name": "Download file",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        220,
        300
      ],
      "parameters": {
        "operation": "download",
        "fileId": {
          "__rl": true,
          "value": "={{ $json.id }}",
          "mode": "id"
        },
        "options": {
          "googleFileConversion": {
            "conversion": {
              "docsToFormat": "application/pdf",
              "slidesToFormat": "application/pdf",
              "sheetsToFormat": "text/csv",
              "drawingsToFormat": "application/pdf"
            }
          }
        }
      }
    },
    {
      "id": "5e2a7c41-8b3d-4f60-9a1e-3c7d2f8b0003",
      "name": "Start NotebookLM job",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.BRIDGE_URL }}/jobs",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Bridge-Token",
              "value": "={{ $env.BRIDGE_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "parameterType": "formBinaryData",
              "name": "file",
              "inputDataFieldName": "data"
            },
            {
              "parameterType": "formData",
              "name": "title_hint",
              "value": "={{ $('New file in Drive folder').item.json.name }}"
            },
            {
              "parameterType": "formData",
              "name": "mime_type",
              "value": "={{ $binary.data.mimeType }}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "5e2a7c41-8b3d-4f60-9a1e-3c7d2f8b0004",
      "name": "Wait",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        660,
        300
      ],
      "webhookId": "8f3c1a2e-5b7d-4e90-a6c4-2d1f0b9e7a55",
      "notes": "2 minutes while the video renders or posts; 10 minutes while it waits for your approval at http://localhost:8766",
      "parameters": {
        "amount": "={{ $json.status === 'awaiting_approval' ? 10 : 2 }}",
        "unit": "minutes"
      }
    },
    {
      "id": "5e2a7c41-8b3d-4f60-9a1e-3c7d2f8b0005",
      "name": "Check job",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        300
      ],
      "parameters": {
        "url": "={{ $env.BRIDGE_URL }}/jobs/{{ $json.job_id || $json.id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Bridge-Token",
              "value": "={{ $env.BRIDGE_TOKEN }}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "5e2a7c41-8b3d-4f60-9a1e-3c7d2f8b0006",
      "name": "Route by status",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        1100,
        300
      ],
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "c1a0f0de-0000-4000-8000-0000000001086170",
                    "leftValue": "={{ $json.status }}",
                    "rightValue": "approved",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "approved"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "c1a0f0de-0000-4000-8000-0000000001097075",
                    "leftValue": "={{ $json.status }}",
                    "rightValue": "published",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "published"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "c1a0f0de-0000-4000-8000-0000000001087265",
                    "leftValue": "={{ $json.status }}",
                    "rightValue": "rejected",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "rejected"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "c1a0f0de-0000-4000-8000-0000000001066572",
                    "leftValue": "={{ $json.status }}",
                    "rightValue": "error",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "failed"
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra",
          "renameFallbackOutput": "still working"
        }
      }
    },
    {
      "id": "5e2a7c41-8b3d-4f60-9a1e-3c7d2f8b0007",
      "name": "Publish to Instagram",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1340,
        100
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.BRIDGE_URL }}/jobs/{{ $json.id }}/publish",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Bridge-Token",
              "value": "={{ $env.BRIDGE_TOKEN }}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "5e2a7c41-8b3d-4f60-9a1e-3c7d2f8b0008",
      "name": "Posted",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1340,
        260
      ],
      "parameters": {},
      "notes": "The Reel is live; $json.permalink links to it"
    },
    {
      "id": "5e2a7c41-8b3d-4f60-9a1e-3c7d2f8b0009",
      "name": "Rejected in review",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1340,
        420
      ],
      "parameters": {}
    },
    {
      "id": "5e2a7c41-8b3d-4f60-9a1e-3c7d2f8b0010",
      "name": "Stop: job failed",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        1340,
        580
      ],
      "parameters": {
        "errorMessage": "=Instagram job {{ $json.id }} failed: {{ $json.error }}"
      }
    }
  ],
  "connections": {
    "New file in Drive folder": {
      "main": [
        [
          {
            "node": "Download file",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Download file": {
      "main": [
        [
          {
            "node": "Start NotebookLM job",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Start NotebookLM job": {
      "main": [
        [
          {
            "node": "Wait",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Wait": {
      "main": [
        [
          {
            "node": "Check job",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check job": {
      "main": [
        [
          {
            "node": "Route by status",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Route by status": {
      "main": [
        [
          {
            "node": "Publish to Instagram",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Posted",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Rejected in review",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Stop: job failed",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Wait",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Publish to Instagram": {
      "main": [
        [
          {
            "node": "Wait",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "tags": []
}
