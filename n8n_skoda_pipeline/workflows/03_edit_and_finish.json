        0
      ],
      "parameters": {
        "executeOnce": true,
        "command": "=ffprobe -v error -show_entries stream=codec_name,width,height,r_frame_rate,duration -of json {{ $('Config').first().json.data_dir }}/out/{{ $('Config').first().json.output_name }}{{ $('Config').first().json.preview ? '_PREVIEW' : '' }}.mp4"
      }
    },
    {
      "id": "62fb1a16-7bc1-5417-921c-b399e8c61b05",
      "name": "Report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        0
      ],
      "parameters": {
        "jsCode": "const cfg = $('Config').first().json;\nlet probe = {}; try { probe = JSON.parse($input.first().json.stdout); } catch (e) {}\nreturn [{ json: { done: true, file: `${cfg.data_dir}/out/${cfg.output_name}${cfg.preview ? '_PREVIEW' : ''}.mp4`, streams: probe.streams,\n  hint: cfg.preview ? 'This is a half-res draft. Set preview:false in Config for the final 1080×1920 render.' : 'Final render complete.' } }];"
      }
    }
