# 1) cp .env.example .env     2) fill the two values     3) never commit .env
# Google AI Studio key from a billing-enabled project (Veo is paid-tier only). Set a spending cap in Google Cloud!
GEMINI_API_KEY=
# any long random string; n8n uses it to encrypt the stored credential.   e.g.  openssl rand -hex 24
N8N_ENCRYPTION_KEY=
