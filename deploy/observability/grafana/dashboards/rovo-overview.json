      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "rovo-prometheus"
          },
          "expr": "up{job=~\"rovo-.*\"}",
          "legendFormat": "{{job}} {{instance}}"
