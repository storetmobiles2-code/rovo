{
  "uid": "rovo-overview",
  "title": "rovo \u2014 golden flow overview",
  "tags": [
    "rovo"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "type": "row",
      "title": "HTTP (RED)",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "title": "Requests/s by status class",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "rovo-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "rovo-prometheus"
          },
          "expr": "sum by (status_class) (rate(rovo_http_request_duration_seconds_count[$__rate_interval]))",
          "legendFormat": "{{status_class}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "title": "5xx ratio",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "rovo-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "rovo-prometheus"
          },
          "expr": "rovo:http_errors5xx:ratio_rate5m",
          "legendFormat": "5xx"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {},
      "description": "SLO: 99.5% non-5xx (closed pilot, R49)"
    },
    {
      "id": 4,
      "title": "p95 latency by route (top 10)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "rovo-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "rovo-prometheus"
          },
          "expr": "topk(10, histogram_quantile(0.95, sum by (le, route) (rate(rovo_http_request_duration_seconds_bucket[$__rate_interval]))))",
          "legendFormat": "{{route}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    },
